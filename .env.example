PORT=3000

# Database Configuration:
# Option 1 (Recommended for Render & Vercel): PostgreSQL Connection String
# For Render PostgreSQL (External URL for Vercel/Local):
DATABASE_URL=postgresql://user:password@host.oregon-postgres.render.com/flexflow?sslmode=require

# Option 2: Local / Classic MySQL Configuration
# DB_HOST=localhost
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=flexflow
# DB_PORT=3306

# Authentication & Admin Setup
JWT_SECRET=change-me-to-a-long-random-string-min-24-chars
ADMIN_EMAIL=admin@flexflow.com
ADMIN_PASSWORD=Admin@123456

# Optional: Claude AI Coach Note in Workout & Diet
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
